# Required — generate a long random string (e.g. openssl rand -hex 32)
ENGINE_API_KEY=your_long_random_api_key_here

# Required for Vercel Blob (auto-injected when you connect Blob storage in Vercel dashboard)
# BLOB_READ_WRITE_TOKEN is set automatically by Vercel when you enable Blob

# Allowed frontend origins (comma-separated). Keep tight.
ALLOWED_ORIGINS=https://1dleryu.vercel.app,http://localhost:3000

# Upload limits (bytes). Free-tier recommendation: keep under 80MB for pure-JS path.
MAX_UPLOAD_BYTES=83886080

# Optional rate-limit window (ms) and max requests per window per key/IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Optional daily quota per API key (number of jobs)
DAILY_JOB_QUOTA=50

# Job retention (hours) before soft-delete of completed results
JOB_RETENTION_HOURS=24

# Optional external FFmpeg worker URL (leave empty for pure-JS only path)
# Example: https://your-ffmpeg-worker.fly.dev or Railway service
FFMPEG_WORKER_URL=
FFMPEG_WORKER_SECRET=
